SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
SUPABASE_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Runtime environment
APP_ENV=development

# Resend Email Configuration
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=noreply@trishul.solutions
FRONTEND_URL=https://trishul.solutions
# In production keep this false to avoid exposing activation tokens in API responses.
EXPOSE_ACTIVATION_LINK=false

# Razorpay Configuration
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RECEIPT_VERIFY_BASE_URL=https://trishul-solutions1.onrender.com/payments/verify/receipt

# PhonePe / UPI Payment Configuration
# Minimal mode (recommended fallback): set owner Hostel UPI ID in Owner Profile.
# Optional global fallback UPI for all owners (DIRECT_UPI mode):
UPI_ID=your-upi-id@bank
PHONEPE_UPI_PAYEE_NAME=Your Hostel Name
PHONEPE_UPI_CURRENCY=INR
PHONEPE_UPI_EXPIRES_IN_SECONDS=900

# Hosted PhonePe PG mode (required for checkout URL based flow)
PHONEPE_MERCHANT_ID=your_phonepe_merchant_id
PHONEPE_CLIENT_ID=your_phonepe_client_id
PHONEPE_CLIENT_SECRET=your_phonepe_client_secret
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_REDIRECT_URL=https://trishul.solutions/payment-return
PHONEPE_CALLBACK_URL=https://api.trishul.solutions/webhooks/phonepe
PHONEPE_AUTH_PATH=/v1/oauth/token
PHONEPE_CREATE_PAYMENT_PATH=/checkout/v2/pay
PHONEPE_STATUS_PATH_TEMPLATE=/checkout/v2/order/{merchant_txn_id}/status
PHONEPE_EXPIRES_IN_SECONDS=900
PHONEPE_SALT_KEY=your_phonepe_salt_key
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox

# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn

# Google OAuth Configuration
# Obtain from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must exactly match an Authorized redirect URI in your Google Cloud OAuth credentials.
# Register ALL of the following in Google Cloud Console > OAuth 2.0 Credentials > Authorized redirect URIs:
#   https://hms-sand-five.vercel.app/callback
#   https://trishul-hms.vercel.app/callback
#   http://localhost:5173/callback  (for local development only)
GOOGLE_REDIRECT_URI=https://hms-sand-five.vercel.app/callback
