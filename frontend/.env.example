VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_API_URL=http://localhost:8000
# Must exactly match an Authorized redirect URI in your Google Cloud OAuth credentials.
# For production set this to your deployed frontend URL, e.g.:
#   https://hms-sand-five.vercel.app/callback
# For local development use:
#   http://localhost:5173/callback
VITE_GOOGLE_REDIRECT_URI=https://hms-sand-five.vercel.app/callback
