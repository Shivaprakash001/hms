// ============================================================
// Move-Out / Exit Management System (migration 060+061)
// Workflow: REQUESTED → INSPECTION_PENDING → INSPECTION_DONE →
//           SETTLEMENT_APPROVED → PAYMENT_PENDING → COMPLETED
//           (branch: DISPUTED → PAYMENT_PENDING)
// ============================================================

model move_out_requests {
  id                        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id                 String        @db.Uuid
  hostel_id                 String        @db.Uuid
  owner_id                  String        @db.Uuid
  status                    MoveOutStatus @default(REQUESTED)
  reason                    MoveOutReason
  reason_text               String?
  planned_exit_date         DateTime      @db.Date
  actual_exit_date          DateTime?     @db.Date
  financial_completion_date DateTime?     @db.Timestamptz(6)
  physical_exit_date        DateTime?     @db.Date
  room_release_date         DateTime?     @db.Date
  notice_period_days        Int           @default(0)
  notice_period_violation   Boolean       @default(false)
  initiated_by              String        @db.Uuid
  initiated_by_role         String        @default("TENANT") @db.VarChar(20)
  is_eviction               Boolean       @default(false)
  eviction_reason           String?
  reviewed_by               String?       @db.Uuid
  reviewed_at               DateTime?     @db.Timestamptz(6)
  review_notes              String?
  cancelled_at              DateTime?     @db.Timestamptz(6)
  cancelled_by              String?       @db.Uuid
  cancellation_reason       String?
  completed_at              DateTime?     @db.Timestamptz(6)
  // Freeze flags — what is locked during move-out
  freeze_room_transfer      Boolean       @default(true)
  freeze_rent_generation    Boolean       @default(true)
  freeze_profile_edits      Boolean       @default(false)
  created_at                DateTime      @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?     @db.Timestamptz(6)

  tenant           tenants                       @relation(fields: [tenant_id], references: [id])
  hostel           hostels                       @relation(fields: [hostel_id], references: [id])
  inspection       move_out_inspections?
  inspection_items move_out_inspection_items[]
  settlement       exit_settlement_transactions?
  feedback         exit_feedbacks?
  disputes         exit_disputes[]

  @@unique([tenant_id, status], map: "udx_mor_tenant_active")
  @@index([hostel_id, status])
  @@index([owner_id, status])
  @@index([planned_exit_date])
  @@index([status, created_at(sort: Desc)])
}

model move_out_inspections {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id        String    @unique @db.Uuid
  inspected_by      String    @db.Uuid
  room_condition    String    @default("GOOD") @db.VarChar(20)
  cleaning_status   String    @default("CLEAN") @db.VarChar(30)
  damages_amount    Decimal   @default(0) @db.Decimal(10, 2)
  cleaning_fee      Decimal   @default(0) @db.Decimal(10, 2)
  missing_items_fee Decimal   @default(0) @db.Decimal(10, 2)
  other_deductions  Decimal   @default(0) @db.Decimal(10, 2)
  total_deductions  Decimal   @default(0) @db.Decimal(10, 2)
  deduction_notes   String?
  evidence_urls     String[]  @default([])
  notes             String?
  inspected_at      DateTime  @default(now()) @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @db.Timestamptz(6)

  request move_out_requests @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([inspected_at])
}

/// Structured inspection checklist — one row per item inspected.
/// This replaces free-text inventory checklists.
model move_out_inspection_items {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id    String   @db.Uuid
  item_name     String   @db.VarChar(100)
  item_category String   @default("FURNITURE") @db.VarChar(30)
  condition     String   @default("OK") @db.VarChar(20)
  charge_amount Decimal  @default(0) @db.Decimal(10, 2)
  notes         String?
  evidence_url  String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  request move_out_requests @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([request_id])
}

model exit_settlement_transactions {
  id         String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id String @unique @db.Uuid
  tenant_id  String @db.Uuid
  owner_id   String @db.Uuid
  hostel_id  String @db.Uuid

  // Deposit side — sourced from tenant_advance_ledger
  security_deposit_amount Decimal @default(0) @db.Decimal(10, 2)
  advance_balance         Decimal @default(0) @db.Decimal(10, 2)

  // Dues side
  pending_rent_dues    Decimal @default(0) @db.Decimal(10, 2)
  pending_late_fees    Decimal @default(0) @db.Decimal(10, 2)
  pending_utility_dues Decimal @default(0) @db.Decimal(10, 2)

  // Deductions from structured inspection
  damages_deduction       Decimal @default(0) @db.Decimal(10, 2)
  cleaning_deduction      Decimal @default(0) @db.Decimal(10, 2)
  missing_items_deduction Decimal @default(0) @db.Decimal(10, 2)
  other_deductions        Decimal @default(0) @db.Decimal(10, 2)

  // Computed totals
  total_deductions Decimal @default(0) @db.Decimal(10, 2)
  total_dues       Decimal @default(0) @db.Decimal(10, 2)

  // Final settlement: positive = owner owes tenant, negative = tenant owes owner
  net_settlement_amount Decimal @default(0) @db.Decimal(10, 2)
  settlement_direction  String  @default("NONE") @db.VarChar(20)

  // Payment tracking
  payment_status      String    @default("PENDING") @db.VarChar(20)
  payment_method      String?   @db.VarChar(30)
  payment_reference   String?
  payment_notes       String?
  settled_at          DateTime? @db.Timestamptz(6)
  settled_by          String?   @db.Uuid
  confirmed_by_tenant Boolean   @default(false)
  confirmed_by_owner  Boolean   @default(false)

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @db.Timestamptz(6)

  request move_out_requests @relation(fields: [request_id], references: [id], onDelete: Cascade)

  @@index([tenant_id])
  @@index([owner_id, hostel_id])
  @@index([payment_status])
}

/// Dispute layer — tracks disagreements on settlement amounts.
