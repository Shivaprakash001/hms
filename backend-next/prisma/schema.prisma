generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model actionLog {
  id         String   @id @db.Uuid
  owner_id   String   @db.Uuid
  action     String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id, action, created_at(sort: Desc)])
  @@map("action_logs")
  @@schema("public")
}

model activity_logs {
  id          String   @id @db.Uuid
  user_id     String   @db.Uuid
  owner_id    String?  @db.Uuid
  action_type String
  entity_type String
  entity_id   String?
  metadata    Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model addonTransactions {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id           String   @db.Uuid
  payment_attempt_id String?  @db.Uuid
  pack               String
  credits_added      Int
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id])
  @@map("addon_transactions")
  @@schema("public")
}

model addonUsage {
  owner_id            String  @id @db.Uuid
  reminders_remaining Int     @default(0)
  reminders_used      Int     @default(0)
  auto_topup          Boolean @default(false)

  @@map("addon_usage")
  @@schema("public")
}

model autopay_attempts {
  id                String        @id @db.Uuid
  subscription_id   String        @db.Uuid
  attempt_at        DateTime      @default(now()) @db.Timestamptz(6)
  result            String
  provider_response String?
  subscriptions     subscriptions @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bulk_import_batches {
  id                                                     String     @id @db.Uuid
  owner_id                                               String     @db.Uuid
  hostel_id                                              String     @db.Uuid
  filename                                               String
  file_size                                              Int?
  total_rows                                             Int        @default(0)
  valid_rows                                             Int        @default(0)
  failed_rows                                            Int        @default(0)
  imported_rows                                          Int        @default(0)
  duplicate_rows                                         Int        @default(0)
  status                                                 String     @default("PENDING")
  validation_errors                                      Json?
  import_summary                                         Json?
  import_source_version                                  String     @default("google_form_v1")
  uploaded_by                                            String     @db.Uuid
  uploaded_at                                            DateTime   @default(now()) @db.Timestamptz(6)
  validated_at                                           DateTime?  @db.Timestamptz(6)
  imported_at                                            DateTime?  @db.Timestamptz(6)
  created_at                                             DateTime   @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime?  @db.Timestamptz(6)
  hostels                                                hostels    @relation(fields: [hostel_id], references: [id])
  profiles_bulk_import_batches_uploaded_byToprofiles     profile   @relation("bulk_import_batches_uploaded_byToprofiles", fields: [uploaded_by], references: [id])
  profiles_profiles_import_batch_idTobulk_import_batches profile[] @relation("profiles_import_batch_idTobulk_import_batches")

  @@index([hostel_id, created_at(sort: Desc)])
  @@index([owner_id, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
  @@schema("public")
}

model complaints {
  id          String    @id @db.Uuid
  tenant_id   String    @db.Uuid
  owner_id    String    @db.Uuid
  title       String
  description String
  category    String
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  resolved_at DateTime? @db.Timestamptz(6)
  comment     String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)
  hostel_id   String    @db.Uuid
  hostels     hostels   @relation(fields: [hostel_id], references: [id])
  tenants     tenants   @relation(fields: [tenant_id], references: [id])

  @@index([hostel_id])
  @@schema("public")
}

model expenses {
  id         String   @id @db.Uuid
  owner_id   String   @db.Uuid
  title      String
  amount     Decimal  @db.Decimal(10, 2)
  date       DateTime @db.Date
  category   String
  status     String?  @default("paid")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  hostel_id  String   @db.Uuid
  hostels    hostels  @relation(fields: [hostel_id], references: [id])
  profiles   profile @relation(fields: [owner_id], references: [id])

  @@index([date])
  @@index([hostel_id, date])
  @@index([hostel_id])
  @@index([owner_id, date])
  @@index([owner_id])
  @@schema("public")
}

model financial_invariant_failures {
  id                      String    @id @db.Uuid
  invariant_type          String
  severity                String
  entity_type             String
  entity_id               String?   @db.Uuid
  expected_value          String?
  actual_value            String?
  owner_id                String?   @db.Uuid
  hostel_id               String?   @db.Uuid
  reconciliation_attempts Int       @default(0)
  status                  String    @default("OPEN")
  details                 Json?
  detected_at             DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at             DateTime? @db.Timestamptz(6)

  @@index([detected_at])
  @@index([hostel_id])
  @@index([invariant_type])
  @@index([severity])
  @@index([status])
  @@schema("public")
}

model hostel_daily_snapshots {
  id                String   @id @db.Uuid
  hostel_id         String   @db.Uuid
  snapshot_date     DateTime @db.Date
  occupancy_rate    Decimal  @default(0) @db.Decimal(7, 2)
  active_tenants    Int      @default(0)
  expected_revenue  Decimal  @default(0) @db.Decimal(12, 2)
  collected_revenue Decimal  @default(0) @db.Decimal(12, 2)
  pending_dues      Decimal  @default(0) @db.Decimal(12, 2)
  overdue_count     Int      @default(0)
  collection_rate   Decimal  @default(0) @db.Decimal(7, 2)
  expenses          Decimal  @default(0) @db.Decimal(12, 2)
  profit            Decimal  @default(0) @db.Decimal(12, 2)
  source_hash       String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([hostel_id, snapshot_date])
  @@index([snapshot_date])
  @@schema("public")
}

model hostel_invariant_checks {
  id             String   @id @db.Uuid
  check_type     String
  entity_type    String
  entity_id      String?  @db.Uuid
  expected_value String?
  actual_value   String?
  is_valid       Boolean  @default(true)
  details        Json?
  checked_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([check_type])
  @@index([checked_at])
  @@index([is_valid])
  @@schema("public")
}

model hostels {
  id                  String                @id @db.Uuid
  owner_id            String                @db.Uuid
  name                String
  phone               String
  address             String
  city                String?
  state               String?
  pincode             String?
  upi_id              String?
  gst_number          String?
  is_active           Boolean               @default(true)
  currency            String                @default("INR") @db.VarChar(3)
  rent_cycle          String                @default("MONTHLY")
  receipt_prefix      String                @default("HMS")
  timezone            String                @default("UTC")
  auto_rent_day       Int                   @default(1)
  phonepe_merchant_id String?
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @db.Timestamptz(6)
  logo_url            String?
  preferences_config  Json?
  bulk_import_batches bulk_import_batches[]
  complaints          complaints[]
  expenses            expenses[]
  profiles            profile              @relation(fields: [owner_id], references: [id])
  payments            payments[]
  receipts            receipts[]
  reminder_logs       reminder_logs[]
  rent_obligations    rent_obligations[]
  room_allocations    roomAllocation[]
  rooms               rooms[]
  tenants             tenants[]
  move_out_requests   move_out_requests[]

  @@schema("public")
}

model identity_tokens {
  jti        String    @id
  user_id    String    @db.Uuid
  purpose    String
  action     String
  expires_at DateTime  @db.Timestamptz(6)
  used       Boolean   @default(false)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, used, expires_at])
  @@schema("public")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model login_attempts {
  id             String   @id @db.Uuid
  identifier     String
  ip_address     String?
  attempt_type   String
  success        Boolean  @default(false)
  failure_reason String?
  user_agent     String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([attempt_type, created_at(sort: Desc)])
  @@index([identifier, created_at(sort: Desc)])
  @@index([identifier, ip_address, created_at(sort: Desc)])
  @@index([ip_address, created_at(sort: Desc)])
  @@schema("public")
}

model message_logs {
  id                String   @id @db.Uuid
  owner_id          String?  @db.Uuid
  sent_at           DateTime @default(now()) @db.Timestamptz(6)
  channel           String?
  template          String?
  recipient         String?
  success           Boolean?
  status            String   @default("SUCCESS")
  idempotency_key   String?  @unique
  pack_id           String?  @db.Uuid
  deduction         Int      @default(0)
  provider_response String?

  @@schema("public")
}

model message_packs {
  id                 String   @id @db.Uuid
  owner_id           String   @db.Uuid
  purchased_at       DateTime @default(now()) @db.Timestamptz(6)
  messages_total     Int
  messages_remaining Int
  price_inr          Int
  notes              String?

  @@schema("public")
}

model migration_audit_runs {
  id                          String   @id @db.Uuid
  audit_date                  DateTime @default(now()) @db.Timestamptz(6)
  artifact_path               String
  orphan_count                Int      @default(0)
  mismatch_count              Int      @default(0)
  unresolved_records_count    Int      @default(0)
  corrected_records_count     Int      @default(0)
  corruption_candidates_count Int      @default(0)
  hostel_rollup_validation    Json?
  summary                     Json?
  created_at                  DateTime @default(now()) @db.Timestamptz(6)

  @@index([audit_date])
  @@schema("public")
}

model notifications {
  id         String   @id @db.Uuid
  profile_id String   @db.Uuid
  title      String
  message    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profiles   profile @relation(fields: [profile_id], references: [id])

  @@schema("public")
}

model overflow_ledger {
  id                              String          @id @db.Uuid
  owner_id                        String          @db.Uuid
  billing_month                   DateTime        @db.Date
  plan_id                         String
  active_tenant_count             Int
  included_limit                  Int
  overflow_count                  Int             @default(0)
  overflow_price_per_tenant_paise Int             @default(0)
  overflow_amount_paise           Int             @default(0)
  invoice_id                      String?         @db.Uuid
  status                          String          @default("PENDING")
  idempotency_key                 String          @unique
  created_at                      DateTime        @default(now()) @db.Timestamptz(6)
  processed_at                    DateTime?       @db.Timestamptz(6)
  owner_invoices                  ownerInvoice? @relation(fields: [invoice_id], references: [id])

  @@unique([owner_id, billing_month])
  @@index([billing_month], map: "idx_ol_billing_month")
  @@index([owner_id], map: "idx_ol_owner_id")
  @@index([status], map: "idx_ol_status")
  @@index([billing_month])
  @@index([owner_id])
  @@index([status])
  @@schema("public")
}

model owner_dashboard_snapshots {
  owner_id             String    @id @db.Uuid
  snapshot_month       DateTime  @db.Date
  tenant_count         Int       @default(0)
  active_tenant_count  Int       @default(0)
  total_room_count     Int       @default(0)
  total_capacity       Int       @default(0)
  vacant_beds          Int       @default(0)
  occupancy_rate       Int       @default(0)
  rent_collected_month Decimal   @default(0) @db.Decimal(12, 2)
  expenses_month       Decimal   @default(0) @db.Decimal(12, 2)
  pending_dues         Decimal   @default(0) @db.Decimal(12, 2)
  overdue_total        Decimal   @default(0) @db.Decimal(12, 2)
  overdue_count        Int       @default(0)
  collection_rate      Int       @default(0)
  monthly_trend        Json?
  monthly_trend_months Int       @default(6)
  stats_computed_at    DateTime? @db.Timestamptz(6)
  monthly_computed_at  DateTime? @db.Timestamptz(6)
  is_stale             Boolean   @default(true)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  updated_at           DateTime  @db.Timestamptz(6)

  @@index([is_stale])
  @@index([monthly_computed_at])
  @@index([stats_computed_at])
  @@schema("public")
}

model ownerInvoice {
  id                  String               @id @db.Uuid
  owner_id            String               @db.Uuid
  subscription_id     String?              @db.Uuid
  plan_id             String?
  invoice_number      String?              @unique
  amount_paise        Int
  status              String               @default("PENDING")
  billing_month       DateTime?            @db.Date
  due_date            DateTime             @db.Date
  expires_at          DateTime?            @db.Timestamptz(6)
  paid_at             DateTime?            @db.Timestamptz(6)
  created_at          DateTime             @default(now()) @db.Timestamptz(6)
  line_items          Json?
  overflow_ledger     overflow_ledger[]
  profiles            profile             @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  plans               plans?               @relation(fields: [plan_id], references: [id])
  owner_subscriptions owner_subscriptions? @relation(fields: [subscription_id], references: [id])
  attempts            paymentAttempt[]

  @@index([owner_id, created_at(sort: Desc)])
  @@index([status])
  @@map("owner_invoices")
  @@schema("public")
}

model owner_onboarding_states {
  owner_id                String    @id @db.Uuid
  onboarding_step         String    @default("ACCOUNT_CREATED")
  onboarding_completed_at DateTime? @db.Timestamptz(6)
  onboarding_last_seen_at DateTime  @default(now()) @db.Timestamptz(6)
  skipped_steps           Json      @default("[]")
  onboarding_source       String?
  onboarding_version      String    @default("v2")
  activation_score        Int       @default(0)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime  @db.Timestamptz(6)

  @@index([activation_score])
  @@index([onboarding_completed_at])
  @@index([onboarding_last_seen_at])
  @@index([onboarding_step])
  @@schema("public")
}

model owner_subscriptions {
  id             String           @id @db.Uuid
  owner_id       String           @unique @db.Uuid
  plan_id        String
  status         String           @default("FREE")
  start_date     DateTime         @db.Date
  end_date       DateTime?        @db.Date
  auto_renew     Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?        @db.Timestamptz(6)
  owner_invoices ownerInvoice[]
  profiles       profile         @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  plans          plans            @relation(fields: [plan_id], references: [id])

  @@index([owner_id])
  @@index([status])
  @@schema("public")
}

model owner_usage_snapshots {
  id                    String   @id @db.Uuid
  owner_id              String   @db.Uuid
  billing_month         DateTime @db.Date
  plan_id               String
  active_tenant_count   Int      @default(0)
  included_limit        Int      @default(0)
  overflow_tenant_count Int      @default(0)
  overflow_amount_paise Int      @default(0)
  peak_tenant_count     Int      @default(0)
  snapshot_taken_at     DateTime @default(now()) @db.Timestamptz(6)
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  @@unique([owner_id, billing_month])
  @@index([billing_month], map: "idx_ous_billing_month")
  @@index([owner_id], map: "idx_ous_owner_id")
  @@index([billing_month])
  @@index([owner_id])
  @@schema("public")
}

model payment_attempt_obligations {
  id                 String           @id @db.Uuid
  payment_attempt_id String           @db.Uuid
  obligation_id      String           @db.Uuid
  amount             Decimal          @db.Decimal(10, 2)
  created_at         DateTime         @default(now()) @db.Timestamptz(6)
  rent_obligations   rent_obligations @relation(fields: [obligation_id], references: [id])
  payment_attempts   paymentAttempt @relation(fields: [payment_attempt_id], references: [id], onDelete: Cascade)

  @@unique([payment_attempt_id, obligation_id])
  @@schema("public")
}

model payment_attempt_status_events {
  id                   String   @id @db.Uuid
  payment_attempt_id   String   @db.Uuid
  transition_sequence  Int
  from_status          String?
  to_status            String
  reason               String?
  source               String
  actor_id             String?  @db.Uuid
  operational_owner_id String?  @db.Uuid
  financial_owner_id   String?  @db.Uuid
  hostel_id            String?  @db.Uuid
  metadata             Json?
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  @@unique([payment_attempt_id, transition_sequence])
  @@index([hostel_id, created_at])
  @@index([payment_attempt_id, created_at])
  @@schema("public")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model paymentAttempt {
  id                          String                        @id @db.Uuid
  obligation_id               String?                       @db.Uuid
  invoice_id                  String?                       @db.Uuid
  tenant_id                   String?                       @db.Uuid
  owner_id                    String                        @db.Uuid
  provider                    String
  merchant_txn_id             String                        @unique
  gateway_txn_id              String?                       @unique
  amount                      Decimal                       @db.Decimal(10, 2)
  status                      AttemptStatus                 @default(CREATED)
  upi_intent_url              String?
  qr_payload                  String?
  expires_at                  DateTime?                     @db.Timestamptz(6)
  confirmed_at                DateTime?                     @db.Timestamptz(6)
  raw_create_response         Json?
  raw_webhook_payload         Json?
  created_at                  DateTime                      @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime?                     @db.Timestamptz(6)
  checkout_url                String?
  payment_type                String                        @default("RENT")
  addon_pack                  String?
  manual_confirmed_by         String?                       @db.Uuid
  manual_confirmed_at         DateTime?                     @db.Timestamptz(6)
  manual_confirm_ip           String?
  hostel_id                   String?                       @db.Uuid
  payment_domain              String?
  scope_type                  String?
  flow_type                   String?
  merchant_context_type       String?
  merchant_context_id         String?
  settlement_status           String?
  settled_at                  DateTime?                     @db.Timestamptz(6)
  merchant_transaction_id     String?
  provider_transaction_id     String?
  provider_order_id           String?
  provider_reference_id       String?
  obligations                 payment_attempt_obligations[]
  invoice                     ownerInvoice?               @relation(fields: [invoice_id], references: [id])
  rent_obligations            rent_obligations?             @relation(fields: [obligation_id], references: [id])
  tenants                     tenants?                      @relation(fields: [tenant_id], references: [id])
  payments                    payments[]

  @@index([flow_type])
  @@index([hostel_id])
  @@index([merchant_context_type, merchant_context_id])
  @@index([payment_domain])
  @@index([provider, provider_order_id])
  @@index([provider, provider_transaction_id])
  @@index([settlement_status])
  @@map("payment_attempts")
  @@schema("public")
}

model payment_operational_anomalies {
  id                    String    @id @db.Uuid
  anomaly_type          String
  severity              String
  payment_domain        String?
  flow_type             String?
  payment_attempt_id    String?   @db.Uuid
  payment_id            String?   @db.Uuid
  webhook_event_id      String?   @db.Uuid
  reconciliation_run_id String?   @db.Uuid
  operational_owner_id  String?   @db.Uuid
  financial_owner_id    String?   @db.Uuid
  hostel_id             String?   @db.Uuid
  status                String    @default("OPEN")
  detected_at           DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at           DateTime? @db.Timestamptz(6)
  metadata              Json?

  @@index([anomaly_type, status])
  @@index([hostel_id, detected_at])
  @@index([operational_owner_id, detected_at])
  @@index([payment_attempt_id])
  @@schema("public")
}

model payment_provider_verification_snapshots {
  id                      String   @id @db.Uuid
  provider                String
  payment_domain          String?
  flow_type               String?
  source                  String
  payment_attempt_id      String?  @db.Uuid
  webhook_event_id        String?  @db.Uuid
  reconciliation_run_id   String?  @db.Uuid
  merchant_transaction_id String?
  provider_transaction_id String?
  provider_order_id       String?
  provider_reference_id   String?
  provider_status         String?
  normalized_status       String
  amount                  Decimal? @db.Decimal(10, 2)
  raw_response            Json?
  raw_response_hash       String
  verified_at             DateTime @default(now()) @db.Timestamptz(6)
  operational_owner_id    String?  @db.Uuid
  financial_owner_id      String?  @db.Uuid
  hostel_id               String?  @db.Uuid

  @@index([hostel_id, verified_at])
  @@index([payment_attempt_id, verified_at])
  @@index([provider, verified_at])
  @@index([raw_response_hash])
  @@schema("public")
}

model payment_reconciliation_items {
  id                    String   @id @db.Uuid
  reconciliation_run_id String   @db.Uuid
  payment_attempt_id    String?  @db.Uuid
  payment_id            String?  @db.Uuid
  anomaly_type          String
  severity              String
  action                String
  result                String
  operational_owner_id  String?  @db.Uuid
  financial_owner_id    String?  @db.Uuid
  hostel_id             String?  @db.Uuid
  metadata              Json?
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  @@index([hostel_id, created_at])
  @@index([payment_attempt_id])
  @@index([reconciliation_run_id])
  @@schema("public")
}

model payment_reconciliation_runs {
  id                   String    @id @db.Uuid
  payment_domain       String
  scope_type           String?
  operational_owner_id String?   @db.Uuid
  financial_owner_id   String?   @db.Uuid
  hostel_id            String?   @db.Uuid
  status               String    @default("RUNNING")
  started_at           DateTime  @default(now()) @db.Timestamptz(6)
  completed_at         DateTime? @db.Timestamptz(6)
  summary              Json?
  error_message        String?

  @@index([hostel_id, started_at])
  @@index([payment_domain, started_at])
  @@schema("public")
}

