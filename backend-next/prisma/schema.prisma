generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model Profile {
  email                 String             @unique
  name                  String
  phone                 String?
  password_hash         String?
  role                  Role
  is_active             Boolean            @default(true)
  is_profile_completed  Boolean            @default(false)
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  created_at            DateTime           @default(now())
  updated_at            DateTime?          @updatedAt
  invitation_token      String?            @unique
  invitation_expires_at DateTime?
  id                    String             @id @default(uuid()) @db.Uuid
  owner_id              String?            @db.Uuid
  emergency_contact     String?
  expenses              Expense[]
  hostels               Hostel[]
  notifications         Notification[]
  invoices              OwnerInvoice[]
  subscription          OwnerSubscription?
  owner                 Profile?           @relation("OwnerTenant", fields: [owner_id], references: [id])
  tenants               Profile[]          @relation("OwnerTenant")
  refresh_tokens        RefreshToken[]
  tenant_details        Tenant?            @relation("TenantToProfile")

  @@index([owner_id])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([owner_id, created_at])
  @@map("profiles")
  @@schema("public")
}

model Tenant {
  id                    String                   @id @db.Uuid
  profile_id            String                   @unique @db.Uuid
  profile_type          String                   @default("STUDENT")
  monthly_rent          Decimal?                 @db.Decimal(10, 2)
  joined_on             DateTime?                @db.Date
  status                TenantStatus             @default(INVITED)
  owner_id              String?                  @db.Uuid
  profile_completed     Boolean                  @default(false)
  photo_url             String?
  phone_1               String?
  phone_2               String?
  phone_3               String?
  personal_email        String?
  college_name          String?
  roll_number           String?
  course                String?
  year_of_study         Int?
  section               String?
  branch                String?
  office_name           String?
  office_location       String?
  job_role              String?
  gender                String?
  date_of_birth         DateTime?                @db.Date
  advance_deposit       Decimal                  @default(0) @db.Decimal(10, 2)
  maintenance_charge    Decimal                  @default(0) @db.Decimal(10, 2)
  maintenance_type      String                   @default("MONTHLY")
  billing_start_date    DateTime?                @db.Date
  permanent_address     String?
  temporary_address     String?
  aadhaar_number        String?                  @unique
  document_verified     Boolean                  @default(false)
  exit_reason           String?
  exit_notes            String?
  exit_date             DateTime?                @db.Date
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?                @updatedAt @db.Timestamptz(6)
  complaints            Complaint[]
  documents             IdentificationDocument[]
  payment_attempts      PaymentAttempt[]
  payments              Payment[]
  reactivation_requests ReactivationRequest[]
  receipts              Receipt[]
  reminders             ReminderLog[]
  obligations           RentObligation[]
  allocations           RoomAllocation[]
  advance_ledger        TenantAdvanceLedger[]
  behavior_score        TenantBehaviorScore?
  profile               Profile                  @relation("TenantToProfile", fields: [profile_id], references: [id])

  @@index([owner_id])
  @@map("tenants")
  @@schema("public")
}

model TenantBehaviorScore {
  tenant_id       String   @id @db.Uuid
  score           Int      @default(100)
  last_calculated DateTime @default(now()) @db.Timestamptz(6)
  metadata        Json?

  tenant          Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([tenant_id, last_calculated])
  @@map("tenant_behavior_scores")
  @@schema("public")
}

model Hostel {
  id                  String    @id @default(uuid()) @db.Uuid
  owner_id            String    @db.Uuid
  name                String
  phone               String
  address             String
  city                String?
  state               String?
  pincode             String?
  upi_id              String?
  gst_number          String?
  is_active           Boolean   @default(true)
  currency            String    @default("INR") @db.VarChar(3)
  rent_cycle          String    @default("MONTHLY")
  receipt_prefix      String    @default("HMS")
  timezone            String    @default("UTC")
  auto_rent_day       Int       @default(1)
  phonepe_merchant_id String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @updatedAt @db.Timestamptz(6)
  logo_url            String?
  preferences_config  Json?
  owner               Profile   @relation(fields: [owner_id], references: [id])
  rooms               Room[]

  @@map("hostels")
  @@schema("public")
}

model Room {
  id          String            @id @default(uuid()) @db.Uuid
  hostel_id   String            @db.Uuid
  room_no     String
  floor       Int?
  capacity    Int
  room_type   String?
  is_active   Boolean           @default(true)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?         @updatedAt @db.Timestamptz(6)
  base_rent   Int?
  activity    RoomActivityLog[]
  allocations RoomAllocation[]
  hostel      Hostel            @relation(fields: [hostel_id], references: [id])

  @@index([hostel_id])
  @@map("rooms")
  @@schema("public")
}

model RoomActivityLog {
  id             String   @id @default(uuid()) @db.Uuid
  room_id        String   @db.Uuid
  owner_id       String   @db.Uuid
  action         String
  previous_value String?
  new_value      String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  room           Room     @relation(fields: [room_id], references: [id])

  @@index([room_id])
  @@index([owner_id])
  @@map("room_activity_logs")
  @@schema("public")
}

model RoomAllocation {
  id          String           @id @default(uuid()) @db.Uuid
  tenant_id   String           @db.Uuid
  room_id     String           @db.Uuid
  start_date  DateTime         @db.Date
  end_date    DateTime?        @db.Date
  is_active   Boolean          @default(true)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?        @updatedAt @db.Timestamptz(6)
  obligations RentObligation[]
  room        Room             @relation(fields: [room_id], references: [id])
  tenant      Tenant           @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id, is_active, end_date])
  @@index([room_id, is_active])
  @@map("room_allocations")
  @@schema("public")
}

model RentObligation {
  id              String                     @id @default(uuid()) @db.Uuid
  tenant_id       String                     @db.Uuid
  allocation_id   String?                    @db.Uuid
  owner_id        String?                    @db.Uuid
  rent_month      DateTime                   @db.Date
  amount          Decimal                    @db.Decimal(10, 2)
  late_fee        Decimal?                   @default(0) @db.Decimal(10, 2)
  total_amount    Decimal                    @db.Decimal(10, 2)
  due_date        DateTime                   @db.Date
  status          PaymentStatus              @default(PENDING)
  created_at      DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?                  @updatedAt @db.Timestamptz(6)
  obligation_type String                     @default("RENT")
  attempt_links   PaymentAttemptObligation[]
  attempts        PaymentAttempt[]
  payments        Payment[]
  reminders       ReminderLog[]
  allocation      RoomAllocation?            @relation(fields: [allocation_id], references: [id])
  tenant          Tenant                     @relation(fields: [tenant_id], references: [id])

  @@unique([allocation_id, rent_month, obligation_type])
  @@index([tenant_id, rent_month])
  @@map("rent_obligations")
  @@schema("public")
}

model TenantAdvanceLedger {
  id             String              @id @default(uuid()) @db.Uuid
  tenant_id      String              @db.Uuid
  owner_id       String              @db.Uuid
  type           AdvanceLedgerType
  reason         AdvanceLedgerReason
  amount         Decimal             @db.Decimal(10, 2)
  balance_after  Decimal             @db.Decimal(10, 2)
  notes          String?
  reference_id   String?             @db.Uuid
  reference_type String?
  refund_status  String?
  created_by     String              @db.Uuid
  created_at     DateTime            @default(now()) @db.Timestamptz(6)
  tenant         Tenant              @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([owner_id])
  @@index([tenant_id, created_at])
  @@map("tenant_advance_ledger")
  @@schema("public")
}

model ReminderLog {
  id            String         @id @default(uuid()) @db.Uuid
  obligation_id String         @db.Uuid
  tenant_id     String         @db.Uuid
  reminder_type String
  channel       String         @default("IN_APP")
  sent_at              DateTime       @default(now()) @db.Timestamptz(6)
  converted_to_payment Boolean        @default(false)
  converted_at         DateTime?      @db.Timestamptz(6)

  obligation           RentObligation @relation(fields: [obligation_id], references: [id], onDelete: Cascade)
  tenant               Tenant         @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@index([obligation_id])
  @@index([tenant_id])
  @@index([converted_to_payment])
  @@map("reminder_logs")
  @@schema("public")
}

model RentGenerationLog {
  id                  String   @id @default(uuid()) @db.Uuid
  rent_month          DateTime @db.Date
  trigger_type        String
  triggered_by        String?  @db.Uuid
  total_allocations   Int      @default(0)
  obligations_created Int      @default(0)
  obligations_skipped Int      @default(0)
  obligations_failed  Int      @default(0)
  duration_ms         Int?
  errors              String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([rent_month])
  @@index([triggered_by])
  @@map("rent_generation_logs")
  @@schema("public")
}

model SystemLock {
  key        String   @id
  locked_at  DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)

  @@map("system_locks")
  @@schema("public")
}

model OwnerDashboardSnapshot {
  owner_id              String   @id @db.Uuid
  snapshot_month        DateTime @db.Date
  tenant_count          Int      @default(0)
  active_tenant_count   Int      @default(0)
  total_room_count      Int      @default(0)
  total_capacity        Int      @default(0)
  vacant_beds           Int      @default(0)
  occupancy_rate        Int      @default(0)
  rent_collected_month  Decimal  @default(0) @db.Decimal(12, 2)
  expenses_month        Decimal  @default(0) @db.Decimal(12, 2)
  pending_dues          Decimal  @default(0) @db.Decimal(12, 2)
  overdue_total         Decimal  @default(0) @db.Decimal(12, 2)
  overdue_count         Int      @default(0)
  collection_rate       Int      @default(0)
  monthly_trend         Json?
  monthly_trend_months  Int      @default(6)
  stats_computed_at     DateTime? @db.Timestamptz(6)
  monthly_computed_at   DateTime? @db.Timestamptz(6)
  is_stale              Boolean  @default(true)
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  updated_at            DateTime @updatedAt @db.Timestamptz(6)

  @@index([is_stale])
  @@index([stats_computed_at])
  @@index([monthly_computed_at])
  @@map("owner_dashboard_snapshots")
  @@schema("public")
}

model Payment {
  id                 String          @id @default(uuid()) @db.Uuid
  obligation_id      String          @db.Uuid
  tenant_id          String          @db.Uuid
  owner_id           String?         @db.Uuid
  amount_paid        Decimal         @db.Decimal(10, 2)
  payment_method     String
  reference_number   String?
  payment_date       DateTime        @db.Date
  payment_attempt_id String?         @db.Uuid
  payment_group_id   String?         @db.Uuid
  idempotency_key      String?         @unique
  offline_recorded_by  String?         @db.Uuid
  offline_recorded_at  DateTime?       @db.Timestamptz(6)
  offline_recorded_ip  String?
  offline_note         String?
  created_at           DateTime        @default(now()) @db.Timestamptz(6)
  obligation           RentObligation  @relation(fields: [obligation_id], references: [id])
  attempt              PaymentAttempt? @relation(fields: [payment_attempt_id], references: [id])
  tenant               Tenant          @relation(fields: [tenant_id], references: [id])
  receipts             Receipt?

  @@index([owner_id])
  @@index([tenant_id])
  @@index([created_at])
  @@index([owner_id, created_at])
  @@index([tenant_id, payment_date])
  @@index([tenant_id, amount_paid])
  @@map("payments")
  @@schema("public")
}

model PaymentAttempt {
  id                  String                     @id @default(uuid()) @db.Uuid
  obligation_id       String?                    @db.Uuid
  invoice_id          String?                    @db.Uuid
  tenant_id           String?                    @db.Uuid
  owner_id            String                     @db.Uuid
  provider            String
  merchant_txn_id     String                     @unique
  gateway_txn_id      String?                    @unique
  amount              Decimal                    @db.Decimal(10, 2)
  status              AttemptStatus              @default(CREATED)
  upi_intent_url      String?
  qr_payload          String?
  expires_at          DateTime?                  @db.Timestamptz(6)
  confirmed_at        DateTime?                  @db.Timestamptz(6)
  raw_create_response Json?
  raw_webhook_payload Json?
  created_at          DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?                  @updatedAt @db.Timestamptz(6)
  checkout_url          String?
  payment_type          String                     @default("RENT")
  addon_pack            String?
  manual_confirmed_by   String?                    @db.Uuid
  manual_confirmed_at   DateTime?                  @db.Timestamptz(6)
  manual_confirm_ip     String?
  obligations           PaymentAttemptObligation[]
  invoice             OwnerInvoice?              @relation(fields: [invoice_id], references: [id])
  obligation          RentObligation?            @relation(fields: [obligation_id], references: [id])
  tenant              Tenant?                    @relation(fields: [tenant_id], references: [id])
  payments            Payment[]

  @@map("payment_attempts")
  @@schema("public")
}

model ActionLog {
  id         String   @id @default(uuid()) @db.Uuid
  owner_id   String   @db.Uuid
  action     String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id, action, created_at(sort: Desc)])
  @@map("action_logs")
  @@schema("public")
}

model IdentityToken {
  jti        String    @id
  user_id    String    @db.Uuid
  purpose    String
  action     String
  expires_at DateTime  @db.Timestamptz(6)
  used       Boolean   @default(false)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, used, expires_at])
  @@map("identity_tokens")
  @@schema("public")
}

model WhatsappLog {
  id            String   @id @default(uuid()) @db.Uuid
  phone         String
  template      String
  obligation_id String?  @db.Uuid
  status        String
  error_message String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  @@index([obligation_id, template, created_at])
  @@map("whatsapp_logs")
  @@schema("public")
}

model PaymentAttemptObligation {
  id                 String         @id @default(uuid()) @db.Uuid
  payment_attempt_id String         @db.Uuid
  obligation_id      String         @db.Uuid
  amount             Decimal        @db.Decimal(10, 2)
  created_at         DateTime       @default(now()) @db.Timestamptz(6)
  obligation         RentObligation @relation(fields: [obligation_id], references: [id])
  payment_attempt    PaymentAttempt @relation(fields: [payment_attempt_id], references: [id], onDelete: Cascade)

  @@unique([payment_attempt_id, obligation_id])
  @@map("payment_attempt_obligations")
  @@schema("public")
}

model IdentificationDocument {
  id               String         @id @default(uuid()) @db.Uuid
  tenant_id        String         @db.Uuid
  doc_type         String
  doc_number       String?
  file_url         String
  /// ImageKit relative path — used for signed URL construction
  file_path        String?
  mime_type        String?
  file_size        Int?
  /// ImageKit fileId for deletion
  file_id          String?
  document_status  DocumentStatus @default(PENDING)
  /// false = archived (replaced by a newer upload of the same type)
  is_active        Boolean        @default(true)
  is_verified      Boolean        @default(false)
  rejection_reason String?
  uploaded_by      String?        @db.Uuid
  approved_by      String?        @db.Uuid
  approved_at      DateTime?      @db.Timestamptz(6)
  rejected_by      String?        @db.Uuid
  rejected_at      DateTime?      @db.Timestamptz(6)
  reject_ip        String?
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  tenant           Tenant         @relation(fields: [tenant_id], references: [id])

  @@index([document_status])
  @@index([tenant_id, doc_type, is_active])
  @@map("identification_documents")
  @@schema("public")
}

model ReactivationRequest {
  id                      String    @id @default(uuid()) @db.Uuid
  tenant_id               String    @db.Uuid
  owner_id                String    @db.Uuid
  requested_by_profile_id String    @db.Uuid
  current_status          String
  status                  String    @default("PENDING")
  notes                   String?
  processed_at            DateTime? @db.Timestamptz(6)
  processed_by            String?   @db.Uuid
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  tenant                  Tenant    @relation(fields: [tenant_id], references: [id])

  @@map("reactivation_requests")
  @@schema("public")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  profile_id String   @db.Uuid
  title      String
  message    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profile    Profile  @relation(fields: [profile_id], references: [id])

  @@map("notifications")
  @@schema("public")
}

model TokenBlacklist {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("token_blacklist")
  @@schema("public")
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Uuid
  user_id    String   @db.Uuid
  token_hash String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profile    Profile  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
  @@schema("public")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  owner_id    String?  @db.Uuid
  action_type String
  entity_type String
  entity_id   String?
  metadata    Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  @@map("activity_logs")
  @@schema("public")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  owner_id   String   @db.Uuid
  title      String
  amount     Decimal  @db.Decimal(10, 2)
  date       DateTime @db.Date
  category   String
  status     String?  @default("paid")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  owner      Profile  @relation(fields: [owner_id], references: [id])

  @@index([owner_id])
  @@index([date])
  @@index([owner_id, date])
  @@map("expenses")
  @@schema("public")
}

model Complaint {
  id          String    @id @default(uuid()) @db.Uuid
  tenant_id   String    @db.Uuid
  owner_id    String    @db.Uuid
  title       String
  description String
  category    String
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  resolved_at DateTime? @db.Timestamptz(6)
  comment     String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  tenant      Tenant    @relation(fields: [tenant_id], references: [id])

  @@map("complaints")
  @@schema("public")
}

model Receipt {
  id                       String    @id @default(uuid()) @db.Uuid
  receipt_number           String    @unique
  payment_id               String    @unique @db.Uuid
  tenant_id                String    @db.Uuid
  owner_id                 String?   @db.Uuid
  amount                   Decimal   @db.Decimal(10, 2)
  payment_method           String
  transaction_id           String?
  hostel_name              String?
  tenant_name              String?
  rent_month               DateTime? @db.Date
  issued_at                DateTime  @default(now()) @db.Timestamptz(6)
  invoice_pdf_url          String?
  invoice_template_version Int?
  receipt_pdf_url          String?
  receipt_template_version Int?
  payment                  Payment   @relation(fields: [payment_id], references: [id])
  tenant                   Tenant    @relation(fields: [tenant_id], references: [id])

  @@map("receipts")
  @@schema("public")
}

model SystemEventLog {
  id         String   @id @default(uuid()) @db.Uuid
  event_type String
  owner_id   String?  @db.Uuid
  tenant_id  String?  @db.Uuid
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id])
  @@index([event_type])
  @@index([created_at])
  @@map("system_event_logs")
  @@schema("public")
}

model OwnerSubscription {
  id         String         @id @default(uuid()) @db.Uuid
  owner_id   String         @unique @db.Uuid
  plan_id    String
  status     String         @default("FREE")
  start_date DateTime       @db.Date
  end_date   DateTime?      @db.Date
  auto_renew Boolean        @default(true)
  created_at DateTime       @default(now()) @db.Timestamptz(6)
  updated_at DateTime?      @updatedAt @db.Timestamptz(6)
  invoices   OwnerInvoice[]
  owner      Profile        @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  plan       Plan           @relation(fields: [plan_id], references: [id])

  @@index([owner_id])
  @@index([status])
  @@map("owner_subscriptions")
  @@schema("public")
}

model OwnerInvoice {
  id              String             @id @default(uuid()) @db.Uuid
  owner_id        String             @db.Uuid
  subscription_id String?            @db.Uuid
  plan_id         String?
  invoice_number  String?            @unique
  amount_paise    Int
  status          String             @default("PENDING")
  billing_month   DateTime?          @db.Date
  due_date        DateTime           @db.Date
  expires_at      DateTime?          @db.Timestamptz(6)
  paid_at         DateTime?          @db.Timestamptz(6)
  created_at      DateTime           @default(now()) @db.Timestamptz(6)
  line_items      Json?
  owner           Profile            @relation(fields: [owner_id], references: [id], onDelete: Cascade)
  plan            Plan?              @relation(fields: [plan_id], references: [id])
  subscription    OwnerSubscription? @relation(fields: [subscription_id], references: [id])
  attempts        PaymentAttempt[]
  overflow_ledgers OverflowLedger[]

  @@index([owner_id, created_at(sort: Desc)])
  @@index([status])
  @@map("owner_invoices")
  @@schema("public")
}

model Plan {
  id                  String              @id
  name                String
  price_inr           Int                 @default(0)
  tenant_limit        Int                 @default(0)
  hostel_limit        Int                 @default(0)
  automation            Boolean             @default(false)
  multi_hostel          Boolean             @default(false)
  analytics             Boolean             @default(false)
  profile_photo         Boolean             @default(false)
  document_verification Boolean             @default(false)
  is_custom             Boolean             @default(false)
  can_generate_receipts               Boolean             @default(false)
  overflow_enabled                    Boolean             @default(false)
  overflow_price_per_tenant_paise     Int                 @default(0)
  overflow_hard_cap                   Int                 @default(0)
  created_at          DateTime            @default(now()) @db.Timestamptz(6)
  features            Json?
  invoices            OwnerInvoice[]
  owner_subscriptions OwnerSubscription[]
  subscriptions       Subscription[]

  @@map("plans")
  @@schema("public")
}

model Subscription {
  id               String           @id @default(uuid()) @db.Uuid
  owner_id         String           @unique @db.Uuid
  plan_id          String
  status           String           @default("TRIAL")
  trial_ends_at    DateTime?        @db.Timestamptz(6)
  start_date       DateTime         @default(now()) @db.Timestamptz(6)
  next_billing_at  DateTime?        @db.Timestamptz(6)
  autopay_enabled  Boolean          @default(true)
  grace_started_at DateTime?        @db.Timestamptz(6)
  grace_ends_at    DateTime?        @db.Timestamptz(6)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  updated_at       DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  autopay_attempts AutopayAttempt[]
  plan             Plan             @relation(fields: [plan_id], references: [id])

  @@map("subscriptions")
  @@schema("public")
}

model MessagePack {
  id                 String   @id @default(uuid()) @db.Uuid
  owner_id           String   @db.Uuid
  purchased_at       DateTime @default(now()) @db.Timestamptz(6)
  messages_total     Int
  messages_remaining Int
  price_inr          Int
  notes              String?

  @@map("message_packs")
  @@schema("public")
}

model MessageLog {
  id                String   @id @default(uuid()) @db.Uuid
  owner_id          String?  @db.Uuid
  sent_at           DateTime @default(now()) @db.Timestamptz(6)
  channel           String?
  template          String?
  recipient         String?
  success           Boolean?
  status            String   @default("SUCCESS")
  idempotency_key   String?  @unique
  pack_id           String?  @db.Uuid
  deduction         Int      @default(0)
  provider_response String?

  @@map("message_logs")
  @@schema("public")
}

model AutopayAttempt {
  id                String       @id @default(uuid()) @db.Uuid
  subscription_id   String       @db.Uuid
  attempt_at        DateTime     @default(now()) @db.Timestamptz(6)
  result            String
  provider_response String?
  subscription      Subscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)

  @@map("autopay_attempts")
  @@schema("public")
}

model UsageTracking {
  owner_id      String @id @db.Uuid
  tenants_count Int    @default(0)
  hostels_count Int    @default(0)

  @@map("usage_tracking")
  @@schema("public")
}

model AddonUsage {
  owner_id            String  @id @db.Uuid
  reminders_remaining Int     @default(0)
  reminders_used      Int     @default(0)
  auto_topup          Boolean @default(false)

  @@map("addon_usage")
  @@schema("public")
}

model AddonTransaction {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id           String   @db.Uuid
  payment_attempt_id String?  @db.Uuid
  pack               String
  credits_added      Int
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id])
  @@map("addon_transactions")
  @@schema("public")
}

model OwnerUsageSnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  owner_id              String   @db.Uuid
  billing_month         DateTime @db.Date
  plan_id               String
  active_tenant_count   Int      @default(0)
  included_limit        Int      @default(0)
  overflow_tenant_count Int      @default(0)
  overflow_amount_paise Int      @default(0)
  peak_tenant_count     Int      @default(0)
  snapshot_taken_at     DateTime @default(now()) @db.Timestamptz(6)
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  @@unique([owner_id, billing_month])
  @@index([owner_id])
  @@index([billing_month])
  @@map("owner_usage_snapshots")
  @@schema("public")
}

model OverflowLedger {
  id                              String        @id @default(uuid()) @db.Uuid
  owner_id                        String        @db.Uuid
  billing_month                   DateTime      @db.Date
  plan_id                         String
  active_tenant_count             Int
  included_limit                  Int
  overflow_count                  Int           @default(0)
  overflow_price_per_tenant_paise Int           @default(0)
  overflow_amount_paise           Int           @default(0)
  invoice_id                      String?       @db.Uuid
  status                          String        @default("PENDING")
  idempotency_key                 String        @unique
  created_at                      DateTime      @default(now()) @db.Timestamptz(6)
  processed_at                    DateTime?     @db.Timestamptz(6)
  invoice                         OwnerInvoice? @relation(fields: [invoice_id], references: [id], onDelete: SetNull)

  @@unique([owner_id, billing_month])
  @@index([owner_id])
  @@index([billing_month])
  @@index([status])
  @@map("overflow_ledger")
  @@schema("public")
}

enum Role {
  ADMIN
  OWNER
  WARDEN
  TENANT

  @@schema("public")
}

enum TenantStatus {
  INVITED
  ACTIVE
  LEFT

  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED

  @@schema("public")
}

enum AttemptStatus {
  CREATED
  PENDING
  PENDING_VERIFICATION
  PENDING_MANUAL_CONFIRMATION
  PROCESSING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED

  @@schema("public")
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}

/// Application-layer document type constants (validated in DocumentService).
/// Stored as VARCHAR in DB to avoid destructive enum migrations on existing data.
/// Values: PROFILE_PHOTO | AADHAAR | PAN | COLLEGE_ID | WORK_ID | PASSPORT

enum AdvanceLedgerType {
  CREDIT
  DEBIT

  @@schema("public")
}

enum AdvanceLedgerReason {
  DEPOSIT
  TOPUP
  ADJUSTMENT
  DEDUCTION
  REFUND
  CORRECTION

  @@schema("public")
}
