generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model Profile {
  email                 String         @unique
  name                  String
  phone                 String?
  password_hash         String?
  role                  Role
  is_active             Boolean        @default(false)
  is_profile_completed  Boolean        @default(false)
  address               String?
  city                  String?
  state                 String?
  pincode               String?
  created_at            DateTime       @default(now())
  updated_at            DateTime?      @updatedAt
  invitation_token      String?        @unique
  invitation_expires_at DateTime?
  id                    String         @id @default(uuid()) @db.Uuid
  owner_id              String?        @db.Uuid
  emergency_contact     String?
  expenses              Expense[]
  hostels               Hostel[]
  notifications         Notification[]
  owner                 Profile?       @relation("OwnerStudent", fields: [owner_id], references: [id])
  students              Profile[]      @relation("OwnerStudent")
  student_details       Student?       @relation("StudentToProfile")

  @@index([owner_id])
  @@index([name])
  @@index([phone])
  @@index([email])
  @@index([owner_id, created_at])
  @@map("profiles")
  @@schema("public")
}

model Student {
  id                    String                   @id @db.Uuid
  profile_id            String                   @unique @db.Uuid
  monthly_rent          Decimal?                 @db.Decimal(10, 2)
  joined_on             DateTime?                @db.Date
  status                StudentStatus            @default(INVITED)
  owner_id              String?                  @db.Uuid
  profile_completed     Boolean                  @default(false)
  photo_url             String?
  phone_1               String?
  phone_2               String?
  phone_3               String?
  personal_email        String?
  college_name          String?
  roll_number           String?
  course                String?
  year_of_study         Int?
  section               String?
  branch                String?
  office_name           String?
  office_location       String?
  job_role              String?
  permanent_address     String?
  temporary_address     String?
  aadhaar_number        String?                  @unique
  document_verified     Boolean                  @default(false)
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?                @updatedAt @db.Timestamptz(6)
  complaints            Complaint[]
  documents             IdentificationDocument[]
  payment_attempts      PaymentAttempt[]
  payments              Payment[]
  reactivation_requests ReactivationRequest[]
  receipts              Receipt[]
  reminders             ReminderLog[]
  obligations           RentObligation[]
  allocations           RoomAllocation[]
  profile               Profile                  @relation("StudentToProfile", fields: [profile_id], references: [id])

  @@index([owner_id])
  @@map("students")
  @@schema("public")
}

model Hostel {
  id                  String    @id @default(uuid()) @db.Uuid
  owner_id            String    @db.Uuid
  name                String
  phone               String
  address             String
  city                String?
  state               String?
  pincode             String?
  upi_id              String?
  gst_number          String?
  is_active           Boolean   @default(true)
  currency            String    @default("INR") @db.VarChar(3)
  rent_cycle          String    @default("MONTHLY")
  receipt_prefix      String    @default("HMS")
  timezone            String    @default("UTC")
  auto_rent_day       Int       @default(1)
  phonepe_merchant_id String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @updatedAt @db.Timestamptz(6)
  logo_url            String?
  preferences_config  Json?
  owner               Profile   @relation(fields: [owner_id], references: [id])
  rooms               Room[]

  @@map("hostels")
  @@schema("public")
}

model Room {
  id          String            @id @default(uuid()) @db.Uuid
  hostel_id   String            @db.Uuid
  room_no     String
  floor       Int?
  capacity    Int
  room_type   String?
  is_active   Boolean           @default(true)
  created_at  DateTime          @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?         @updatedAt @db.Timestamptz(6)
  base_rent   Int?
  activity    RoomActivityLog[]
  allocations RoomAllocation[]
  hostel      Hostel            @relation(fields: [hostel_id], references: [id])

  @@index([hostel_id])
  @@map("rooms")
  @@schema("public")
}

model RoomActivityLog {
  id             String   @id @default(uuid()) @db.Uuid
  room_id        String   @db.Uuid
  owner_id       String   @db.Uuid
  action         String
  previous_value String?
  new_value      String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  room           Room     @relation(fields: [room_id], references: [id])

  @@index([room_id])
  @@index([owner_id])
  @@map("room_activity_logs")
  @@schema("public")
}

model RoomAllocation {
  id          String           @id @default(uuid()) @db.Uuid
  student_id  String           @db.Uuid
  room_id     String           @db.Uuid
  start_date  DateTime         @db.Date
  end_date    DateTime?        @db.Date
  is_active   Boolean          @default(true)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?        @updatedAt @db.Timestamptz(6)
  obligations RentObligation[]
  room        Room             @relation(fields: [room_id], references: [id])
  student     Student          @relation(fields: [student_id], references: [id])

  @@index([student_id, is_active, end_date])
  @@index([room_id, is_active])
  @@map("room_allocations")
  @@schema("public")
}

model RentObligation {
  id              String           @id @default(uuid()) @db.Uuid
  student_id      String           @db.Uuid
  allocation_id   String?          @db.Uuid
  owner_id        String?          @db.Uuid
  rent_month      DateTime         @db.Date
  amount          Decimal          @db.Decimal(10, 2)
  due_date        DateTime         @db.Date
  status          PaymentStatus    @default(PENDING)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  updated_at      DateTime?        @updatedAt @db.Timestamptz(6)
  obligation_type String           @default("RENT")
  attempts        PaymentAttempt[]
  payments        Payment[]
  reminders       ReminderLog[]
  allocation      RoomAllocation?  @relation(fields: [allocation_id], references: [id])
  student         Student          @relation(fields: [student_id], references: [id])

  @@unique([allocation_id, rent_month, obligation_type])
  @@index([student_id, rent_month])
  @@map("rent_obligations")
  @@schema("public")
}

model ReminderLog {
  id            String         @id @default(uuid()) @db.Uuid
  obligation_id String         @db.Uuid
  student_id    String         @db.Uuid
  reminder_type String
  channel       String         @default("IN_APP")
  sent_at       DateTime       @default(now()) @db.Timestamptz(6)
  obligation    RentObligation @relation(fields: [obligation_id], references: [id], onDelete: Cascade)
  student       Student        @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([obligation_id])
  @@index([student_id])
  @@map("reminder_logs")
  @@schema("public")
}

model RentGenerationLog {
  id                  String   @id @default(uuid()) @db.Uuid
  rent_month          DateTime @db.Date
  trigger_type        String
  triggered_by        String?  @db.Uuid
  total_allocations   Int      @default(0)
  obligations_created Int      @default(0)
  obligations_skipped Int      @default(0)
  obligations_failed  Int      @default(0)
  duration_ms         Int?
  errors              String?
  created_at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([rent_month])
  @@index([triggered_by])
  @@map("rent_generation_logs")
  @@schema("public")
}

model SystemLock {
  key        String   @id
  locked_at  DateTime @default(now()) @db.Timestamptz(6)
  expires_at DateTime @db.Timestamptz(6)

  @@map("system_locks")
  @@schema("public")
}

model Payment {
  id                 String          @id @default(uuid()) @db.Uuid
  obligation_id      String          @db.Uuid
  student_id         String          @db.Uuid
  owner_id           String?         @db.Uuid
  amount_paid        Decimal         @db.Decimal(10, 2)
  payment_method     String
  reference_number   String?
  payment_date       DateTime        @db.Date
  payment_attempt_id String?         @db.Uuid
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  obligation         RentObligation  @relation(fields: [obligation_id], references: [id])
  attempt            PaymentAttempt? @relation(fields: [payment_attempt_id], references: [id])
  student            Student         @relation(fields: [student_id], references: [id])
  receipts           Receipt[]

  @@index([owner_id])
  @@index([student_id])
  @@index([created_at])
  @@index([owner_id, created_at])
  @@index([student_id, payment_date])
  @@index([student_id, amount_paid])
  @@map("payments")
  @@schema("public")
}

model PaymentAttempt {
  id                  String         @id @default(uuid()) @db.Uuid
  obligation_id       String         @db.Uuid
  student_id          String         @db.Uuid
  owner_id            String         @db.Uuid
  provider            String
  merchant_txn_id     String         @unique
  gateway_txn_id      String?        @unique
  amount              Decimal        @db.Decimal(10, 2)
  status              AttemptStatus  @default(CREATED)
  upi_intent_url      String?
  qr_payload          String?
  expires_at          DateTime?      @db.Timestamptz(6)
  confirmed_at        DateTime?      @db.Timestamptz(6)
  raw_create_response Json?
  raw_webhook_payload Json?
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?      @updatedAt @db.Timestamptz(6)
  checkout_url        String?
  obligation          RentObligation @relation(fields: [obligation_id], references: [id])
  student             Student        @relation(fields: [student_id], references: [id])
  payments            Payment[]

  @@map("payment_attempts")
  @@schema("public")
}

model IdentificationDocument {
  id               String         @id @default(uuid()) @db.Uuid
  tenant_id        String         @db.Uuid
  doc_type         String
  doc_number       String?
  file_url         String
  is_verified      Boolean        @default(false)
  uploaded_by      String?        @db.Uuid
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  document_status  DocumentStatus @default(PENDING)
  /// ImageKit fileId for deletion
  file_id          String?
  rejection_reason String?
  student          Student        @relation(fields: [tenant_id], references: [id])

  @@index([document_status])
  @@map("identification_documents")
  @@schema("public")
}

model ReactivationRequest {
  id                      String    @id @default(uuid()) @db.Uuid
  student_id              String    @db.Uuid
  owner_id                String    @db.Uuid
  requested_by_profile_id String    @db.Uuid
  current_status          String
  status                  String    @default("PENDING")
  notes                   String?
  processed_at            DateTime? @db.Timestamptz(6)
  processed_by            String?   @db.Uuid
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  student                 Student   @relation(fields: [student_id], references: [id])

  @@map("reactivation_requests")
  @@schema("public")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  profile_id String   @db.Uuid
  title      String
  message    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profile    Profile  @relation(fields: [profile_id], references: [id])

  @@map("notifications")
  @@schema("public")
}

model TokenBlacklist {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("token_blacklist")
  @@schema("public")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  owner_id    String?  @db.Uuid
  action_type String
  entity_type String
  entity_id   String?
  metadata    Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  @@map("activity_logs")
  @@schema("public")
}

model Expense {
  id         String   @id @default(uuid()) @db.Uuid
  owner_id   String   @db.Uuid
  title      String
  amount     Decimal  @db.Decimal(10, 2)
  date       DateTime @db.Date
  category   String
  status     String?  @default("paid")
  created_at DateTime @default(now()) @db.Timestamptz(6)
  owner      Profile  @relation(fields: [owner_id], references: [id])

  @@index([owner_id])
  @@index([date])
  @@index([owner_id, date])
  @@map("expenses")
  @@schema("public")
}

model Complaint {
  id          String    @id @default(uuid()) @db.Uuid
  student_id  String    @db.Uuid
  owner_id    String    @db.Uuid
  title       String
  description String
  category    String
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  resolved_at DateTime? @db.Timestamptz(6)
  comment     String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  student     Student   @relation(fields: [student_id], references: [id])

  @@map("complaints")
  @@schema("public")
}

model Receipt {
  id             String    @id @default(uuid()) @db.Uuid
  receipt_number String    @unique
  payment_id     String    @db.Uuid
  student_id     String    @db.Uuid
  owner_id       String?   @db.Uuid
  amount         Decimal   @db.Decimal(10, 2)
  payment_method String
  transaction_id String?
  hostel_name     String?
  tenant_name     String?
  rent_month      DateTime? @db.Date
  issued_at       DateTime  @default(now()) @db.Timestamptz(6)
  invoice_pdf_url String?   // ✅ Final PDF storage
  payment         Payment   @relation(fields: [payment_id], references: [id])
  student         Student   @relation(fields: [student_id], references: [id])

  @@map("receipts")
  @@schema("public")
}

model SystemEventLog {
  id         String   @id @default(uuid()) @db.Uuid
  event_type String
  owner_id   String?  @db.Uuid
  student_id String?  @db.Uuid
  metadata   Json?
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id])
  @@index([event_type])
  @@index([created_at])
  @@map("system_event_logs")
  @@schema("public")
}

enum Role {
  ADMIN
  OWNER
  WARDEN
  STUDENT

  @@schema("public")
}

enum StudentStatus {
  INVITED
  ACTIVE
  LEFT

  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED

  @@schema("public")
}

enum AttemptStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED
  PENDING_VERIFICATION

  @@schema("public")
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("public")
}
