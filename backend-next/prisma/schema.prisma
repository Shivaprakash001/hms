generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model Profile {
  id                   String         @id @db.Uuid
  email                String         @unique
  password_hash        String?
  name                 String
  role                 Role           @default(ADMIN)
  is_active            Boolean        @default(true)
  is_profile_completed Boolean        @default(false)
  phone                String?
  address              String?
  emergency_contact    String?
  aadhaar_number       String?        @db.VarChar(12)
  owner_id             String?        @db.Uuid
  due_day              Int?           @default(5)
  created_at           DateTime       @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?      @updatedAt @db.Timestamptz(6)
  hostels              Hostel[]
  notifications        Notification[]
  expenses             Expense[]

  owner                Profile?       @relation("OwnerToManager", fields: [owner_id], references: [id])
  managers             Profile[]      @relation("OwnerToManager")
  student              Student?

  @@map("profiles")
  @@schema("public")
}

model Student {
  id                    String                   @id @db.Uuid
  profile_id            String                   @unique @db.Uuid
  monthly_rent          Decimal?                 @db.Decimal(10, 2)
  joined_on             DateTime?                @db.Date
  status                StudentStatus            @default(INVITED)
  owner_id              String?                  @db.Uuid
  profile_completed     Boolean                  @default(false)
  photo_url             String?
  phone_1               String?
  phone_2               String?
  phone_3               String?
  personal_email        String?
  college_name          String?
  roll_number           String?
  course                String?
  year_of_study         Int?
  section               String?
  branch                String?
  office_name           String?
  office_location       String?
  job_role              String?
  permanent_address     String?
  temporary_address     String?
  aadhaar_number        String?
  document_verified     Boolean                  @default(false)
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?                @updatedAt @db.Timestamptz(6)
  documents             IdentificationDocument[]
  payment_attempts      PaymentAttempt[]
  payments              Payment[]
  reactivation_requests ReactivationRequest[]
  complaints            Complaint[]

  obligations           RentObligation[]
  allocations           RoomAllocation[]
  profile               Profile                  @relation(fields: [profile_id], references: [id])

  @@map("students")
  @@schema("public")
}

model Hostel {
  id                  String    @id @default(uuid()) @db.Uuid
  owner_id            String    @db.Uuid
  name                String
  phone               String
  address             String
  city                String?
  state               String?
  pincode             String?
  upi_id              String?
  gst_number          String?
  is_active           Boolean   @default(true)
  currency            String    @default("INR") @db.VarChar(3)
  rent_cycle          String    @default("MONTHLY")
  receipt_prefix      String    @default("HMS")
  timezone            String    @default("UTC")
  auto_rent_day       Int       @default(1)
  phonepe_merchant_id String?
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @updatedAt @db.Timestamptz(6)
  owner               Profile   @relation(fields: [owner_id], references: [id])
  rooms               Room[]

  @@map("hostels")
  @@schema("public")
}

model Room {
  id          String           @id @default(uuid()) @db.Uuid
  hostel_id   String           @db.Uuid
  room_no     String
  floor       Int?
  capacity    Int
  room_type   String?
  is_active   Boolean          @default(true)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?        @updatedAt @db.Timestamptz(6)
  allocations RoomAllocation[]
  hostel      Hostel           @relation(fields: [hostel_id], references: [id])

  @@map("rooms")
  @@schema("public")
}

model RoomAllocation {
  id          String           @id @default(uuid()) @db.Uuid
  student_id  String           @db.Uuid
  room_id     String           @db.Uuid
  start_date  DateTime         @db.Date
  end_date    DateTime?        @db.Date
  is_active   Boolean          @default(true)
  created_at  DateTime         @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?        @updatedAt @db.Timestamptz(6)
  obligations RentObligation[]
  room        Room             @relation(fields: [room_id], references: [id])
  student     Student          @relation(fields: [student_id], references: [id])

  @@map("room_allocations")
  @@schema("public")
}

model RentObligation {
  id            String           @id @default(uuid()) @db.Uuid
  student_id    String           @db.Uuid
  allocation_id String?          @db.Uuid
  owner_id      String?          @db.Uuid
  rent_month    DateTime         @db.Date
  amount        Decimal          @db.Decimal(10, 2)
  due_date      DateTime         @db.Date
  status        PaymentStatus    @default(PENDING)
  created_at    DateTime         @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?        @updatedAt @db.Timestamptz(6)
  attempts      PaymentAttempt[]
  payments      Payment[]
  allocation    RoomAllocation?  @relation(fields: [allocation_id], references: [id])
  student       Student          @relation(fields: [student_id], references: [id])

  @@map("rent_obligations")
  @@schema("public")
}

model Payment {
  id                 String          @id @default(uuid()) @db.Uuid
  obligation_id      String          @db.Uuid
  student_id         String          @db.Uuid
  owner_id           String?         @db.Uuid
  amount_paid        Decimal         @db.Decimal(10, 2)
  payment_method     String
  reference_number   String?
  payment_date       DateTime        @db.Date
  payment_attempt_id String?         @db.Uuid
  created_at         DateTime        @default(now()) @db.Timestamptz(6)
  obligation         RentObligation  @relation(fields: [obligation_id], references: [id])
  attempt            PaymentAttempt? @relation(fields: [payment_attempt_id], references: [id])
  student            Student         @relation(fields: [student_id], references: [id])

  @@map("payments")
  @@schema("public")
}

model PaymentAttempt {
  id                  String         @id @default(uuid()) @db.Uuid
  obligation_id       String         @db.Uuid
  student_id          String         @db.Uuid
  owner_id            String         @db.Uuid
  provider            String
  merchant_txn_id     String         @unique
  gateway_txn_id      String?
  amount              Decimal        @db.Decimal(10, 2)
  status              AttemptStatus  @default(CREATED)
  upi_intent_url      String?
  qr_payload          String?
  expires_at          DateTime?      @db.Timestamptz(6)
  confirmed_at        DateTime?      @db.Timestamptz(6)
  raw_create_response Json?
  raw_webhook_payload Json?
  created_at          DateTime       @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?      @updatedAt @db.Timestamptz(6)
  obligation          RentObligation @relation(fields: [obligation_id], references: [id])
  student             Student        @relation(fields: [student_id], references: [id])
  payments            Payment[]

  @@map("payment_attempts")
  @@schema("public")
}

model IdentificationDocument {
  id          String   @id @default(uuid()) @db.Uuid
  tenant_id   String   @db.Uuid
  doc_type    String
  doc_number  String?
  file_url    String
  is_verified Boolean  @default(false)
  uploaded_by String?  @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  student     Student  @relation(fields: [tenant_id], references: [id])

  @@map("identification_documents")
  @@schema("public")
}

model ReactivationRequest {
  id                      String    @id @default(uuid()) @db.Uuid
  student_id              String    @db.Uuid
  owner_id                String    @db.Uuid
  requested_by_profile_id String    @db.Uuid
  current_status          String
  status                  String    @default("PENDING")
  notes                   String?
  processed_at            DateTime? @db.Timestamptz(6)
  processed_by            String?   @db.Uuid
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  student                 Student   @relation(fields: [student_id], references: [id])

  @@map("reactivation_requests")
  @@schema("public")
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  profile_id String   @db.Uuid
  title      String
  message    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profile    Profile  @relation(fields: [profile_id], references: [id])

  @@map("notifications")
  @@schema("public")
}

model TokenBlacklist {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("token_blacklist")
  @@schema("public")
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  user_id     String   @db.Uuid
  owner_id    String?  @db.Uuid
  action_type String
  entity_type String
  entity_id   String?
  metadata    Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(6)

  @@map("activity_logs")
  @@schema("public")
}

enum Role {
  ADMIN
  OWNER
  WARDEN
  STUDENT

  @@schema("public")
}

enum StudentStatus {
  INVITED
  ACTIVE
  LEFT

  @@schema("public")
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  WAIVED

  @@schema("public")
}

enum AttemptStatus {
  CREATED
  PENDING
  SUCCESS
  FAILED
  EXPIRED
  CANCELLED

  @@schema("public")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  owner_id    String   @db.Uuid
  title       String
  amount      Decimal  @db.Decimal(10, 2)
  date        DateTime @db.Date
  category    String
  status      String?  @default("paid")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  owner       Profile  @relation(fields: [owner_id], references: [id])

  @@map("expenses")
  @@schema("public")
}

model Complaint {
  id          String    @id @default(uuid()) @db.Uuid
  student_id  String    @db.Uuid
  owner_id    String    @db.Uuid
  title       String
  description String
  category    String
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  resolved_at DateTime? @db.Timestamptz(6)
  comment     String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @updatedAt @db.Timestamptz(6)
  student     Student   @relation(fields: [student_id], references: [id])

  @@map("complaints")
  @@schema("public")
}

