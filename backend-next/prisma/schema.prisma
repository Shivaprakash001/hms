generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model actionLog {
  id         String   @id @db.Uuid
  owner_id   String   @db.Uuid
  action     String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([owner_id, action, created_at(sort: Desc)])
  @@map("action_logs")
}

model activity_logs {
  id          String   @id @db.Uuid
  user_id     String   @db.Uuid
  owner_id    String?  @db.Uuid
  action_type String
  entity_type String
  entity_id   String?
  metadata    Json?
  timestamp   DateTime @default(now()) @db.Timestamptz(6)
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model bulk_import_batches {
  id                                                     String    @id @db.Uuid
  owner_id                                               String    @db.Uuid
  hostel_id                                              String    @db.Uuid
  filename                                               String
  file_size                                              Int?
  total_rows                                             Int       @default(0)
  valid_rows                                             Int       @default(0)
  failed_rows                                            Int       @default(0)
  imported_rows                                          Int       @default(0)
  duplicate_rows                                         Int       @default(0)
  status                                                 String    @default("PENDING")
  validation_errors                                      Json?
  import_summary                                         Json?
  import_source_version                                  String    @default("google_form_v1")
  uploaded_by                                            String    @db.Uuid
  uploaded_at                                            DateTime  @default(now()) @db.Timestamptz(6)
  validated_at                                           DateTime? @db.Timestamptz(6)
  imported_at                                            DateTime? @db.Timestamptz(6)
  created_at                                             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                                             DateTime? @db.Timestamptz(6)
  hostels                                                hostels   @relation(fields: [hostel_id], references: [id])
  profiles_bulk_import_batches_uploaded_byToprofiles     profile   @relation("bulk_import_batches_uploaded_byToprofiles", fields: [uploaded_by], references: [id])
  profiles_profiles_import_batch_idTobulk_import_batches profile[] @relation("profiles_import_batch_idTobulk_import_batches")
  bulk_import_rows                                      bulk_import_rows[]
  tenant_invitations                                    tenant_invitations[]
  tenant_invitation_reservations                        tenant_invitation_reservations[]

  @@index([hostel_id, created_at(sort: Desc)])
  @@index([owner_id, created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
}

model bulk_import_rows {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  batch_id            String    @db.Uuid
  owner_id            String    @db.Uuid
  hostel_id           String    @db.Uuid
  row_number          Int
  normalized_email    String
  normalized_phone    String
  normalized_room     String
  mapped_data         Json
  validation_status   String    @default("PENDING")
  conflict_type       String?
  owner_decision      String?
  tenant_id           String?   @db.Uuid
  invitation_id       String?   @db.Uuid
  reservation_id      String?   @db.Uuid
  execution_status    String    @default("PENDING")
  email_status        String?
  error_message       String?
  executed_at         DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @db.Timestamptz(6)
  batch               bulk_import_batches @relation(fields: [batch_id], references: [id])
  tenant              tenants? @relation(fields: [tenant_id], references: [id])
  invitation          tenant_invitations? @relation(fields: [invitation_id], references: [id])
  reservation         tenant_invitation_reservations? @relation(fields: [reservation_id], references: [id])

  @@unique([batch_id, normalized_email, normalized_phone])
  @@index([owner_id, hostel_id, execution_status])
  @@index([batch_id, validation_status])
  @@index([tenant_id])
  @@map("bulk_import_rows")
}

model complaints {
  id          String    @id @db.Uuid
  tenant_id   String    @db.Uuid
  owner_id    String    @db.Uuid
  title       String
  description String
  category    String
  status      String    @default("PENDING")
  priority    String    @default("MEDIUM")
  resolved_at DateTime? @db.Timestamptz(6)
  comment     String?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @db.Timestamptz(6)
  hostel_id   String    @db.Uuid
  hostels     hostels   @relation(fields: [hostel_id], references: [id])
  tenants     tenants   @relation(fields: [tenant_id], references: [id])

  @@index([hostel_id])
}

model expenses {
  id                  String    @id @db.Uuid
  owner_id            String    @db.Uuid
  title               String
  amount              Decimal   @db.Decimal(10, 2)
  date                DateTime  @db.Date
  category            String
  status              String?   @default("paid")
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  hostel_id           String?   @db.Uuid
  notes               String?
  vendor_name         String?
  payment_method      String?
  receipt_url         String?
  receipt_uploaded_at DateTime? @db.Timestamptz(6)
  is_recurring        Boolean   @default(false)
  recurring_frequency String?
  created_by          String?   @db.Uuid
  approved_by         String?   @db.Uuid
  expense_type        String    @default("VARIABLE")
  tags                String[]  @default([])
  metadata            Json?
  hostels             hostels?  @relation(fields: [hostel_id], references: [id])
  profiles            profile   @relation(fields: [owner_id], references: [id])

  @@index([date])
  @@index([hostel_id, category, date])
  @@index([hostel_id, date])
  @@index([hostel_id, status])
  @@index([hostel_id])
  @@index([owner_id, date])
  @@index([owner_id])
}

model financial_invariant_failures {
  id                      String    @id @db.Uuid
  invariant_type          String
  severity                String
  entity_type             String
  entity_id               String?   @db.Uuid
  expected_value          String?
  actual_value            String?
  owner_id                String?   @db.Uuid
  hostel_id               String?   @db.Uuid
  reconciliation_attempts Int       @default(0)
  status                  String    @default("OPEN")
  details                 Json?
  detected_at             DateTime  @default(now()) @db.Timestamptz(6)
  resolved_at             DateTime? @db.Timestamptz(6)

  @@index([detected_at])
  @@index([hostel_id])
  @@index([invariant_type])
  @@index([severity])
  @@index([status])
}

model hostel_daily_snapshots {
  id                String   @id @db.Uuid
  hostel_id         String   @db.Uuid
  snapshot_date     DateTime @db.Date
  occupancy_rate    Decimal  @default(0) @db.Decimal(7, 2)
  active_tenants    Int      @default(0)
  expected_revenue  Decimal  @default(0) @db.Decimal(12, 2)
  collected_revenue Decimal  @default(0) @db.Decimal(12, 2)
  pending_dues      Decimal  @default(0) @db.Decimal(12, 2)
  overdue_count     Int      @default(0)
  collection_rate   Decimal  @default(0) @db.Decimal(7, 2)
  expenses          Decimal  @default(0) @db.Decimal(12, 2)
  profit            Decimal  @default(0) @db.Decimal(12, 2)
  source_hash       String?
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  @@unique([hostel_id, snapshot_date])
  @@index([snapshot_date])
}

model hostel_invariant_checks {
  id             String   @id @db.Uuid
  check_type     String
  entity_type    String
  entity_id      String?  @db.Uuid
  expected_value String?
  actual_value   String?
  is_valid       Boolean  @default(true)
  details        Json?
  checked_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([check_type])
  @@index([checked_at])
  @@index([is_valid])
}

model hostels {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  owner_id            String                   @db.Uuid
  name                String
  phone               String
  address             String
  city                String?
  state               String?
  pincode             String?
  upi_id              String?
  gst_number          String?
  is_active           Boolean                  @default(true)
  currency            String                   @default("INR") @db.VarChar(3)
  rent_cycle          String                   @default("MONTHLY")
  receipt_prefix      String                   @default("SAH")
  timezone            String                   @default("UTC")
  auto_rent_day       Int                      @default(1)
  phonepe_merchant_id String?
  public_slug         String?                  @unique
  admissions_enabled  Boolean                  @default(true)
  admission_photos    Json?
  created_at          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?                @db.Timestamptz(6)
  logo_url            String?
  preferences_config  Json?
  bulk_import_batches bulk_import_batches[]
  complaints          complaints[]
  rule_acceptances    TenantPolicyAcceptance[]
  expenses            expenses[]
  rule_versions       RuleVersion[]
  profiles            profile                  @relation(fields: [owner_id], references: [id])
  payments            payments[]
  receipts            receipts[]
  reminder_logs       reminder_logs[]
  rent_obligations    rent_obligations[]
  room_allocations    roomAllocation[]
  rooms               rooms[]
  floors              floors[]
  tenants             tenants[]
  move_out_requests   move_out_requests[]
  visitor_leads       visitor_leads[]
  room_reservations   room_reservations[]
  tenant_invitations  tenant_invitations[]
  tenant_invitation_reservations tenant_invitation_reservations[]
  agreements          Agreement[]
  agreement_templates AgreementTemplate[]
}

model identity_tokens {
  jti        String    @id
  user_id    String    @db.Uuid
  purpose    String
  action     String
  expires_at DateTime  @db.Timestamptz(6)
  used       Boolean   @default(false)
  used_at    DateTime? @db.Timestamptz(6)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  @@index([user_id, used, expires_at])
}

model identificationDocument {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  doc_type         String
  doc_number       String?
  file_url         String
  file_path        String?
  file_id          String?
  mime_type        String
  file_size        Int
  document_status  String    @default("PENDING")
  is_verified      Boolean   @default(false)
  is_active        Boolean   @default(true)
  uploaded_by      String?
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @db.Timestamptz(6)
  rejection_reason String?
  approved_by      String?   @db.Uuid
  approved_at      DateTime? @db.Timestamptz(6)
  rejected_by      String?   @db.Uuid
  rejected_at      DateTime? @db.Timestamptz(6)
  reject_ip        String?
  tenant           tenants   @relation(fields: [tenant_id], references: [id])

  @@index([tenant_id])
  @@index([tenant_id, is_active])
  @@index([tenant_id, doc_type, is_active])
  @@map("identification_documents")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model login_attempts {
  id             String   @id @db.Uuid
  identifier     String
  ip_address     String?
  attempt_type   String
  success        Boolean  @default(false)
  failure_reason String?
  user_agent     String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  @@index([attempt_type, created_at(sort: Desc)])
  @@index([identifier, created_at(sort: Desc)])
  @@index([identifier, ip_address, created_at(sort: Desc)])
  @@index([ip_address, created_at(sort: Desc)])
}

model message_logs {
  id                String   @id @db.Uuid
  owner_id          String?  @db.Uuid
  sent_at           DateTime @default(now()) @db.Timestamptz(6)
  channel           String?
  template          String?
  recipient         String?
  success           Boolean?
  status            String   @default("SUCCESS")
  idempotency_key   String?  @unique
  pack_id           String?  @db.Uuid
  deduction         Int      @default(0)
  provider_response String?
}

model message_packs {
  id                 String   @id @db.Uuid
  owner_id           String   @db.Uuid
  purchased_at       DateTime @default(now()) @db.Timestamptz(6)
  messages_total     Int
  messages_remaining Int
  price_inr          Int
  notes              String?
}

model migration_audit_runs {
  id                          String   @id @db.Uuid
  audit_date                  DateTime @default(now()) @db.Timestamptz(6)
  artifact_path               String
  orphan_count                Int      @default(0)
  mismatch_count              Int      @default(0)
  unresolved_records_count    Int      @default(0)
  corrected_records_count     Int      @default(0)
  corruption_candidates_count Int      @default(0)
  hostel_rollup_validation    Json?
  summary                     Json?
  created_at                  DateTime @default(now()) @db.Timestamptz(6)

  @@index([audit_date])
}

model notifications {
  id         String   @id @db.Uuid
  profile_id String   @db.Uuid
  title      String
  message    String
  type       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  profiles   profile  @relation(fields: [profile_id], references: [id])
}

model owner_dashboard_snapshots {
  owner_id             String    @id @db.Uuid
  snapshot_month       DateTime  @db.Date
  tenant_count         Int       @default(0)
  active_tenant_count  Int       @default(0)
  total_room_count     Int       @default(0)
  total_capacity       Int       @default(0)
  vacant_beds          Int       @default(0)
  occupancy_rate       Int       @default(0)
  rent_collected_month Decimal   @default(0) @db.Decimal(12, 2)
  expenses_month       Decimal   @default(0) @db.Decimal(12, 2)
  pending_dues         Decimal   @default(0) @db.Decimal(12, 2)
  overdue_total        Decimal   @default(0) @db.Decimal(12, 2)
  overdue_count        Int       @default(0)
  collection_rate      Int       @default(0)
  monthly_trend        Json?
