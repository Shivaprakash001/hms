<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Invoice <%= invoiceNo %></title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');
    
    body {
      font-family: 'Inter', sans-serif;
      color: #1e293b;
      margin: 0;
      padding: 40px;
      background-color: #ffffff;
    }
    
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 50px;
    }
    
    .logo-container img {
      max-width: 150px;
      max-height: 80px;
      object-fit: contain;
    }
    
    .invoice-title-block {
      text-align: right;
    }
    
    .invoice-title {
      font-size: 42px;
      font-weight: 800;
      letter-spacing: -1px;
      margin: 0 0 10px 0;
      color: #0f172a;
      text-transform: uppercase;
    }
    
    .invoice-meta {
      font-size: 14px;
      color: #64748b;
    }

    .meta-row {
      margin-bottom: 4px;
    }
    
    .meta-row strong {
      color: #1e293b;
    }
    
    .address-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 50px;
    }
    
    .address-block {
      width: 45%;
    }
    
    .address-title {
      font-size: 13px;
      font-weight: 700;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 1px;
      margin-bottom: 8px;
    }
    
    .address-content {
      font-size: 15px;
      line-height: 1.5;
    }
    
    .address-content strong {
      font-size: 16px;
      color: #0f172a;
      display: block;
      margin-bottom: 4px;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 30px;
    }
    
    th {
      background-color: #f1f5f9;
      color: #475569;
      font-size: 13px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 12px 16px;
      text-align: left;
    }
    
    th:last-child {
      text-align: right;
    }
    
    td {
      padding: 16px;
      border-bottom: 1px solid #e2e8f0;
      font-size: 15px;
      color: #334155;
    }
    
    td:last-child {
      text-align: right;
      font-weight: 600;
      color: #0f172a;
    }
    
    .totals-wrapper {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 50px;
    }
    
    .totals-table {
      width: 300px;
      margin-bottom: 0;
    }
    
    .totals-table td {
      padding: 12px 16px;
      border-bottom: none;
    }
    
    .totals-table tr.total-row {
      border-top: 2px solid #0f172a;
    }
    
    .totals-table tr.total-row td {
      font-size: 18px;
      font-weight: 700;
      color: #0f172a;
      padding-top: 16px;
    }
    
    .payment-details {
      background-color: #f8fafc;
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 50px;
    }
    
    .payment-details h4 {
      margin: 0 0 10px 0;
      font-size: 15px;
      color: #0f172a;
    }
    
    .payment-details p {
      margin: 4px 0;
      font-size: 14px;
      color: #475569;
    }
    
    .footer {
      border-top: 1px solid #e2e8f0;
      padding-top: 20px;
      margin-top: auto;
      text-align: center;
      color: #64748b;
      font-size: 13px;
    }
  </style>
</head>
<body>

  <div class="header">
    <div class="logo-container">
      <% if (hostel.logo_url) { %>
        <img src="<%= hostel.logo_url %>" alt="Hostel Logo" crossorigin="anonymous">
      <% } else { %>
        <h2><%= hostel.name %></h2>
      <% } %>
    </div>
    <div class="invoice-title-block">
      <h1 class="invoice-title">INVOICE</h1>
      <div class="invoice-meta">
        <div class="meta-row">Invoice No: <strong><%= invoiceNo %></strong></div>
        <div class="meta-row">Date: <strong><%= date %></strong></div>
        <div class="meta-row">Status: <strong style="color: #10b981;"><%= payment.status %></strong></div>
      </div>
    </div>
  </div>

  <div class="address-section">
    <div class="address-block">
      <div class="address-title">From:</div>
      <div class="address-content">
        <strong><%= hostel.name %></strong>
        <%= hostel.address %><br>
        <%= hostel.city %>, <%= hostel.state %> <%= hostel.pincode %><br>
        Phone: <%= hostel.phone %><br>
        <% if (hostel.upi_id) { %> UPI: <%= hostel.upi_id %><br><% } %>
        <% if (hostel.gst_number) { %> GST: <%= hostel.gst_number %><% } %>
      </div>
    </div>
    
    <div class="address-block">
      <div class="address-title">Billed To:</div>
      <div class="address-content">
        <strong><%= tenant.name %></strong>
        Room: <%= room %><br>
        Hostel: <%= hostel.name %><br>
        Tenant ID: <%= tenant.student_id %><br>
        Phone: <%= tenant.phone %>
      </div>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th>Month</th>
        <th>Amount</th>
      </tr>
    </thead>
    <tbody>
      <% rentItems.forEach(function(item) { %>
        <tr>
          <td><%= item.description %></td>
          <td><%= item.month %></td>
          <td><%= hostel.currency %> <%= item.amount.toFixed(2) %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <div class="totals-wrapper">
    <table class="totals-table">
      <tr class="total-row">
        <td>Total Paid</td>
        <td><%= hostel.currency %> <%= total.toFixed(2) %></td>
      </tr>
    </table>
  </div>

  <div class="payment-details">
    <h4>Payment Details</h4>
    <p><strong>Amount Paid:</strong> <%= hostel.currency %> <%= total.toFixed(2) %></p>
    <p><strong>Method:</strong> <%= payment.method %></p>
    <% if (payment.transaction_id) { %>
      <p><strong>Transaction ID:</strong> <%= payment.transaction_id %></p>
    <% } %>
    <p><strong>Payment Date:</strong> <%= payment.date %></p>
  </div>

  <div class="footer">
    <p>Thank you for staying with us!</p>
    <p>For support: support@trishul.solutions</p>
  </div>

</body>
</html>
